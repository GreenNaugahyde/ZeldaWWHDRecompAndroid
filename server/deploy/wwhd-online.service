# wwhd-online-server under systemd (fork; docs/online-server-vps.md). Installed by install.sh.
[Unit]
Description=WWHD online server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wwhd
Group=wwhd
ExecStart=/opt/wwhd/bin/wwhd-online-server --config /etc/wwhd-online/server.toml
WorkingDirectory=/var/lib/wwhd-online
# the fork's daily quests: quests.txt (optional) and quests-state.txt live here, not beside the read-only config
Environment=WWHD_QUESTS_DIR=/var/lib/wwhd-online
StateDirectory=wwhd-online
StateDirectoryMode=0700
# /run/wwhd-online: the admin socket (0600) and the status socket (0660, group wwhd: the status page's user)
RuntimeDirectory=wwhd-online
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3
# "admin restart 30" ends the process normally after its notice: bring it back then too
RestartForceExitStatus=0
TimeoutStopSec=20
LimitNOFILE=16384
MemoryMax=1G
TasksMax=256

# sandbox: no privileges, read-only system, only its own state directory writable
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
IPAddressAllow=any

[Install]
WantedBy=multi-user.target
